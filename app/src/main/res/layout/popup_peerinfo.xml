<?xml version="1.0" encoding="utf-8"?>
<!-- Added ID to root for click-to-close -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popupRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="25dp"
    android:elevation="1.5dp"
    android:background="@drawable/f_rounded_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Added ID: photo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:shapeAppearanceOverlay="@style/CircleImage"
            android:src="@drawable/img_placeholder"/>

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="Lorem Ipsum"
            android:textColor="@color/black"
            android:fontFamily="@font/psbold"
            android:textSize="@dimen/mid"/>

    </LinearLayout>

    <!-- Added ID: status -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/f_rounded_green"
        android:text="Loading.."
        android:fontFamily="@font/psbold"
        android:textSize="@dimen/reg"
        android:textColor="@color/white"
        android:gravity="center"/>

    <!-- Added ID: year -->
    <TextView
        android:id="@+id/year"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/f_rounded_inactive"
        android:text="Loading.."
        android:fontFamily="@font/psbold"
        android:textSize="@dimen/reg"
        android:textColor="@color/textgrey"
        android:gravity="center"/>

    <!-- Added ID: program -->
    <TextView
        android:id="@+id/program"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/f_rounded_inactive"
        android:text="Loading..."
        android:fontFamily="@font/psbold"
        android:textSize="@dimen/reg"
        android:textColor="@color/textgrey"
        android:gravity="center"/>

</LinearLayout>