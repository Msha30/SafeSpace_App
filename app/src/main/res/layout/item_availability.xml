<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp">

    <TextView
        android:id="@+id/txtDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/psbold"
        android:text="@string/date"
        android:textColor="@color/textgrey"
        android:textSize="@dimen/small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/timeSlot1"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/f_rounded_white"
            android:padding="0dp">

            <TextView
                android:id="@+id/txtTimeSlot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 - 10:00"
                android:fontFamily="@font/ps"
                android:textSize="@dimen/small"
                android:textColor="@color/black" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/timeSlot2"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:gravity="center"
            android:background="@drawable/f_rounded_white"
            android:padding="0dp">

            <TextView
                android:id="@+id/txtTimeSlot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 - 10:00"
                android:fontFamily="@font/ps"
                android:textSize="@dimen/small"
                android:textColor="@color/black" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/timeSlot3"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/f_rounded_white"
            android:padding="0dp">

            <TextView
                android:id="@+id/txtTimeSlot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 - 10:00"
                android:fontFamily="@font/ps"
                android:textSize="@dimen/small"
                android:textColor="@color/black" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/timeSlot4"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:gravity="center"
            android:background="@drawable/f_rounded_white"
            android:padding="0dp">

            <TextView
                android:id="@+id/txtTimeSlot4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 - 10:00"
                android:fontFamily="@font/ps"
                android:textSize="@dimen/small"
                android:textColor="@color/black" />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>