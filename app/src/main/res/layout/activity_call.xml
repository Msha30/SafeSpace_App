<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Remote Video View (Full Screen) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Local Video View (Picture-in-Picture) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/local_view"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Info Container -->
    <LinearLayout
        android:id="@+id/top_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/gradient_overlay_top"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_peer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting..."
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling..."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center" />

    </LinearLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="32dp"
        android:background="@drawable/gradient_overlay_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Toggle Microphone -->
        <ImageButton
            android:id="@+id/btn_toggle_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_call_button"
            android:src="@drawable/ic_mic_on"
            android:contentDescription="Toggle Microphone"
            android:scaleType="centerInside"
            android:padding="14dp" />

        <!-- End Call -->
        <ImageButton
            android:id="@+id/btn_end_call"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_end_call_button"
            android:src="@drawable/ic_call_end"
            android:contentDescription="End Call"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:elevation="4dp" />

        <!-- Toggle Camera -->
        <ImageButton
            android:id="@+id/btn_toggle_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_call_button"
            android:src="@drawable/ic_camera_on"
            android:contentDescription="Toggle Camera"
            android:scaleType="centerInside"
            android:padding="14dp" />

        <!-- Switch Camera -->
        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_call_button"
            android:src="@drawable/ic_switch_camera"
            android:contentDescription="Switch Camera"
            android:scaleType="centerInside"
            android:padding="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>