<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scaleType="centerCrop"
    android:background="@drawable/main_background"
    tools:context=".home.HomeCounselingForm">

    <LinearLayout
        android:id="@+id/header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/ic_return"
            android:backgroundTint="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guidance Counseling Session"
            android:fontFamily="@font/psbold"
            android:textColor="@color/white"
            android:textSize="@dimen/mid"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/f_rounded_start"
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:paddingTop="30dp"
        android:paddingBottom="50dp"
        android:scaleType="centerCrop"
        android:scrollbars="none"
        app:flow_horizontalAlign="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1.9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Name"
                        android:fontFamily="@font/psbold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/small"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@id/fname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/header"
                        android:fontFamily="@font/ps"
                        android:textSize="@dimen/reg"
                        android:textColor="@color/textgrey"
                        android:gravity="center_vertical"
                        android:paddingLeft="20dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Name"
                        android:fontFamily="@font/psbold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/small"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@id/lname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/header"
                        android:fontFamily="@font/ps"
                        android:textSize="@dimen/reg"
                        android:textColor="@color/textgrey"
                        android:gravity="center_vertical"
                        android:paddingLeft="20dp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Program"
                        android:fontFamily="@font/psbold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/small"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@id/program"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/header"
                        android:fontFamily="@font/ps"
                        android:textSize="@dimen/reg"
                        android:textColor="@color/textgrey"
                        android:gravity="center_vertical"
                        android:paddingLeft="20dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student ID"
                        android:fontFamily="@font/psbold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/small"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@id/student_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/header"
                        android:fontFamily="@font/ps"
                        android:textSize="@dimen/reg"
                        android:textColor="@color/textgrey"
                        android:gravity="center_vertical"
                        android:paddingLeft="20dp"/>


                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preffered mode of platform "
                android:fontFamily="@font/psbold"
                android:textColor="@color/black"
                android:textSize="@dimen/small"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/PrefPlat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:text="  Call"
                    android:fontFamily="@font/ps"
                    android:textColor="@color/black"
                    android:textSize="@dimen/reg"/>

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:text="  Video Call"
                    android:fontFamily="@font/ps"
                    android:textColor="@color/black"
                    android:textSize="@dimen/reg"/>

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:text="  Face to Face"
                    android:fontFamily="@font/ps"
                    android:textColor="@color/black"
                    android:textSize="@dimen/reg"/>

            </RadioGroup>

            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnsubmit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:padding="0dp"
                android:text="Submit"
                android:fontFamily="@font/psbold"
                android:textSize="@dimen/reg"
                android:textColor="@color/white"
                app:backgroundTint="@null"
                android:background="@drawable/f_rounded_blue"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>