<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/light"
    android:paddingTop="50dp"
    android:paddingBottom="50dp"
    android:paddingStart="25dp"
    android:paddingEnd="25dp"
    android:orientation="vertical"
    tools:context=".home.Home2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="30dp"
            android:src="@drawable/logo"
            android:padding="0dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <ImageView
                android:id="@+id/addEvent"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_addevent"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/peersupport"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/counseling"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/main_background"
            app:shapeAppearanceOverlay="@style/RoundedImage"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@id/counseling"
            app:layout_constraintStart_toStartOf="@id/counseling"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/circ1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_counseling"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/sessionbtn2"
                android:textColor="@color/white"
                android:fontFamily="@font/psbold"
                android:textSize="@dimen/reg"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upcoming"
        android:fontFamily="@font/psbold"
        android:textSize="@dimen/small"
        android:textColor="@color/textgrey"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/f_rounded_inactive"
        android:padding="15dp"
        android:text="No upcoming sessions..."
        android:textSize="@dimen/small"
        android:textColor="@color/textgrey"
        android:gravity="center"
        android:visibility="gone"
        android:fontFamily="@font/ps_ttf"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/upcoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:listitem="@layout/item_upcoming"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notifications"
        android:fontFamily="@font/psbold"
        android:textSize="@dimen/small"
        android:textColor="@color/textgrey"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notifications"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="65dp"
        android:orientation="vertical"
        tools:listitem="@layout/item_notif"/>

</LinearLayout>